# LLM (OpenRouter)
OPENROUTER_API_KEY=
MODEL=google/gemini-4-argon            # extraction model A (scored the same as Opus 5.5 on the corpus at half the cost)
FALLBACK_MODEL=anthropic/claude-opus-5.5   # model B: OpenRouter routes here if A fails, and the UI offers "re-run with model B"
ASK_MODEL=anthropic/claude-opus-5.5    # model for the Ask tool loop (SQL + judgement); empty = MODEL
PDF_ENGINE=native            # native | mistral-ocr | cloudflare-ai
REASONING_EFFORT=medium
TABLE_REASONING_EFFORT=low   # spreadsheets and CSVs: lighter think, several times faster; the rows are already structured

# App
APP_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
DATABASE_URL=                # empty = sqlite at ./data/docintel.db ; e.g. postgresql+psycopg://user:pass@host/db
SYNC_INTERVAL_SECONDS=60
WATCH_DIR=                   # optional: a folder on this machine to watch exactly like the Drive folder (e.g. ~/Desktop/File_ingest)
EXTRACT_CONCURRENCY=3
PII_IDENTITY_POLICY=reject   # reject | allow: identity documents (driver's licence, passport, ID, SSN card) are detected locally and never sent to the model
APP_PASSWORD=                # optional: when set, the whole app asks for this password (use it on a deployed demo)
DAILY_COST_CAP_USD=0         # optional: stop calling the model once today's spend reaches this (0 = no cap)
PII_REDACT=1                 # mask SSN / card / account / routing numbers before the model sees a document's text

# Google OAuth (Web application client; redirect URI = BASE_URL + /api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ESCALATION_WEBHOOK_URL=      # optional: Slack-compatible webhook for "Send to engineering"; unset in the demo, the button then only shows what it would send
DATA_DIR=                    # optional: where originals, the sample corpus and the local SQLite live (default ./data; /mnt/data on Cloud Run)
